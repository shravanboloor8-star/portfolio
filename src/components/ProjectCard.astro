---
import { type Project } from "../lib/supabase";

interface Props {
  project: Project & {
    logo?: string;
    color?: string;
    glowColor?: string;
    tagline?: string;
  };
}

const { project } = Astro.props;

const projectUrl =
  project.live_link && project.live_link !== "#"
    ? project.live_link
    : project.github_link || "#";
---

<a
  href={projectUrl}
  target={projectUrl !== "#" ? "_blank" : undefined}
  rel={projectUrl !== "#" ? "noopener noreferrer" : undefined}
  class="group relative rounded-2xl border border-slate-200 bg-white/60 hover:bg-white backdrop-blur-md flex flex-col h-full shadow-sm hover:shadow-md transition-all duration-500 hover:-translate-y-1 block cursor-pointer overflow-hidden"
>
  <!-- Ambient Hover Color overlay -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-primary-500/5 via-transparent to-secondary-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
  >
  </div>

  <!-- Main Content: Logo (Left) + Info (Right) -->
  <div class="flex-1 flex gap-5 p-6">
    <!-- Logo on Left -->
    <div class="shrink-0">
      <div
        class="w-16 h-16 rounded-2xl bg-gradient-to-br from-slate-100 to-slate-50 shadow-sm border border-slate-200/60 flex items-center justify-center group-hover:scale-110 group-hover:shadow-md transition-all duration-500 overflow-hidden relative"
      >
        {
          project.image_url &&
          (project.image_url.startsWith("http") ||
            project.image_url.startsWith("/")) ? (
            <img
              src={project.image_url}
              alt={project.name}
              class="w-full h-full object-contain p-2 bg-white"
              onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.classList.remove('hidden');"
            />
          ) : null
        }
        <span
          class={`text-4xl filter drop-shadow-sm select-none transition-transform duration-300 group-hover:scale-110 ${project.image_url && (project.image_url.startsWith("http") || project.image_url.startsWith("/")) ? "hidden" : ""}`}
        >
          {project.logo || "💻"}
        </span>
      </div>
    </div>

    <!-- Content on Right -->
    <div class="flex-1 flex flex-col justify-start min-w-0 gap-3">
      <!-- Role/Tagline Badge -->
      {
        project.role && (
          <div class="inline-flex items-center gap-1">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">
              {project.role}
            </span>
          </div>
        )
      }

      <!-- Title -->
      <div>
        <h3
          class="text-base sm:text-lg font-bold font-display text-slate-800 group-hover:text-primary-600 transition-colors duration-300 line-clamp-2"
        >
          {project.name}
        </h3>

        <!-- Tagline -->
        {
          project.tagline && (
            <p class="text-xs font-semibold text-primary-600 tracking-wide mt-1">
              {project.tagline}
            </p>
          )
        }
      </div>

      <!-- Description -->
      <p
        class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm leading-relaxed line-clamp-2 flex-1"
      >
        {project.description}
      </p>
    </div>
  </div>

  <!-- Tech Stack Chips at bottom -->
  <div class="px-6 pb-6 pt-4 border-t border-slate-100 dark:border-slate-800">
    {
      project.tech_stack && project.tech_stack.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {project.tech_stack.slice(0, 3).map((tech) => (
            <span class="text-[10px] bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-900/50 dark:to-slate-800/50 text-slate-700 dark:text-slate-300 px-2.5 py-1.5 rounded-lg border border-slate-200/70 dark:border-slate-700/70 font-medium hover:border-primary-400 dark:hover:border-primary-500/50 hover:text-primary-600 dark:hover:text-primary-400 transition-all duration-300 shadow-sm hover:shadow-md">
              {tech}
            </span>
          ))}
          {project.tech_stack.length > 3 && (
            <span class="text-[10px] bg-slate-50 dark:bg-slate-900/30 text-slate-600 dark:text-slate-400 px-2.5 py-1.5 rounded-lg border border-slate-200/70 dark:border-slate-700/70 font-bold">
              +{project.tech_stack.length - 3}
            </span>
          )}
        </div>
      )
    }
  </div>
</a>
